# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor (cron de resumos e script de seed). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail dos resumos (resend.com)
RESEND_API_KEY=
EMAIL_REMETENTE="Agenda dos Anciãos <agenda@seu-dominio.com>"

# Segredo que a Vercel Cron envia no header Authorization
CRON_SECRET=

# URL pública do app (usada nos links do e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000
