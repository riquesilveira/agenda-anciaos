# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor (cron de resumos e script de seed). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail dos resumos (resend.com)
RESEND_API_KEY=
EMAIL_REMETENTE="IASD Agenda <agenda@seu-dominio.com>"

# Segredo que o GitHub Actions envia no header Authorization (mesmo valor no Render e no GitHub)
CRON_SECRET=

# URL pública do app (usada nos links do e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notificações no celular (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
